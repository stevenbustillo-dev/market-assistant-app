{
  "name": "Market Assistant",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "customizations": {
    "vscode": {
      "extensions": [
        "mhutchie.git-graph",
        "eamodio.gitlens",
        "redhat.vscode-yaml",
        "redhat.vscode-xml",
        "esbenp.prettier-vscode",
        "streetsidesoftware.code-spell-checker",
        "streetsidesoftware.code-spell-checker-spanish",
        "inferrinizzard.prettier-sql-vscode",
        "Dart-Code.dart-code",
        "Dart-Code.flutter"
      ]
    }
  },
  "mounts": [
    "source=${localEnv:HOME}/.ssh,target=/home/flutter/.ssh,readonly,type=bind"
  ],
  "remoteUser": "flutter",
  "postCreateCommand": "curl -fsSL https://opencode.ai/install | bash",
  "postStartCommand": "adb start-server"
}
